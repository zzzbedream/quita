{
  "name": "quita",
  "version": "0.1.0",
  "description": "On-chain credit life insurance layer with cryptographically verified cross-chain loan state, built on the Attestcoin Protocol",
  "license": "MIT",
  "private": true,
  "scripts": {
    "build": "hardhat compile",
    "test": "hardhat test",
    "coverage": "hardhat coverage",
    "preflight": "hardhat run scripts/preflight.ts --network sepolia",
    "probe": "hardhat run scripts/probe.ts --network creditcoin",
    "deploy:origin": "hardhat run scripts/deploy.origin.ts --network sepolia",
    "deploy:creditcoin": "hardhat run scripts/deploy.creditcoin.ts --network creditcoin",
    "emit:demo": "hardhat run scripts/emit.demo.ts --network sepolia",
    "verify:e2e": "hardhat run scripts/verify.e2e.ts --network creditcoin",
    "worker": "ts-node worker/src/index.ts"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.9.0",
    "hardhat": "2.29.1",
    "solidity-coverage": "^0.8.13",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "@gluwa/asc-contracts": "0.2.1",
    "@gluwa/usc-sdk": "0.18.0",
    "@openzeppelin/contracts": "^5.1.0",
    "better-sqlite3": "^11.5.0",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.4"
  }
}
